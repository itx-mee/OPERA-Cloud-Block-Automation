    <ui:InvokeCode ContinueOnError="{x:Null}" Code="ostrMainBody = idictAssetsData(&quot;Room Grid Main Body&quot;).ToString&#xD;&#xA;&#xD;&#xA;For Each row As System.Data.DataRow In idtRoomGrid.Rows&#xD;&#xA;&#xD;&#xA;    Dim tempBody As String = idictAssetsData(&quot;Room Grid Sub Body&quot;).ToString&#xD;&#xA;&#xD;&#xA;    ' ARRIVAL / DEPARTURE DATE&#xD;&#xA;    '=====================================================&#xD;&#xA;&#xD;&#xA;    Dim arrivalDate As DateTime = DateTime.ParseExact(&#xD;&#xA;        System.Text.RegularExpressions.Regex.Replace(row(&quot;strDate&quot;).ToString().Trim(), &quot;(\d+)(st|nd|rd|th)&quot;, &quot;$1&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase),&#xD;&#xA;        New String() {&quot;yyyy-MM-dd&quot;, &quot;dd/MM/yyyy&quot;, &quot;dd/MM/yy&quot;, &quot;dd MMMM yy&quot;, &quot;d MMMM yyyy&quot;, &quot;dd MMMM yyyy&quot;, &quot;d MMMM&quot;, &quot;dd MMMM&quot;},&#xD;&#xA;        System.Globalization.CultureInfo.InvariantCulture,&#xD;&#xA;        System.Globalization.DateTimeStyles.None&#xD;&#xA;    )&#xD;&#xA;&#xD;&#xA;    Dim departureDate As DateTime = arrivalDate.AddDays(1)&#xD;&#xA;&#xD;&#xA;    ' RATE&#xD;&#xA;    '=====================================================&#xD;&#xA;&#xD;&#xA;    Dim rateAmount As Decimal = CDec(row(&quot;strRatePerRoom&quot;).ToString())&#xD;&#xA;&#xD;&#xA;    ' PROPERTY CODE / HOTEL TYPE&#xD;&#xA;    '=====================================================&#xD;&#xA;&#xD;&#xA;    Dim strPropertyCode = idictBlockDetails(&quot;strPropertyCode&quot;).Substring(idictBlockDetails(&quot;strPropertyCode&quot;).Count - 3)&#xD;&#xA;&#xD;&#xA;    Dim strHotelType As String = (&#xD;&#xA;        From r As System.Data.DataRow In idtPropertyCodeMapping.AsEnumerable()&#xD;&#xA;        Where r.Field(Of String)(&quot;Property Code&quot;).Substring(2).Equals(strPropertyCode)&#xD;&#xA;        Select r.Field(Of String)(&quot;Hotel Type&quot;)&#xD;&#xA;    ).FirstOrDefault()&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ' ROOM TYPE / ROOM CODE&#xD;&#xA;    '=====================================================&#xD;&#xA;&#xD;&#xA;    Dim strRoomType As String = row(&quot;strRoomType&quot;).ToString().Trim()&#xD;&#xA;    Dim roomTypeCode As String = Nothing&#xD;&#xA;&#xD;&#xA;    For Each mappingRow As System.Data.DataRow In idtRoomTypeMapping.Rows&#xD;&#xA;&#xD;&#xA;        Dim strMappedRoomType As String = mappingRow(&quot;Room Type&quot;).ToString().Trim()&#xD;&#xA;&#xD;&#xA;        If String.Equals(strMappedRoomType, strRoomType, StringComparison.OrdinalIgnoreCase) Then&#xD;&#xA;&#xD;&#xA;            ' Check Code 1, Code 2, Code 3... in order&#xD;&#xA;            For Each col As System.Data.DataColumn In idtRoomTypeMapping.Columns&#xD;&#xA;&#xD;&#xA;                If String.Equals(col.ColumnName.Trim(), &quot;Room Type&quot;, StringComparison.OrdinalIgnoreCase) Then Continue For&#xD;&#xA;&#xD;&#xA;                Dim strMappingCode As String = mappingRow(col).ToString().Trim()&#xD;&#xA;                If String.IsNullOrWhiteSpace(strMappingCode) Then Continue For&#xD;&#xA;&#xD;&#xA;                ' Compare mapping code with available room types&#xD;&#xA;                For Each strAvailableRoomType As String In ilstRoomTypes&#xD;&#xA;&#xD;&#xA;                    Dim arrRoomType() As String = strAvailableRoomType.Split(&quot;|&quot;c)&#xD;&#xA;                    If arrRoomType.Length &lt; 2 Then Continue For&#xD;&#xA;&#xD;&#xA;                    Dim strAvailableCode As String = arrRoomType(arrRoomType.Length - 1).Trim()&#xD;&#xA;&#xD;&#xA;                    If String.Equals(strMappingCode, strAvailableCode, StringComparison.OrdinalIgnoreCase) Then&#xD;&#xA;                        roomTypeCode = strMappingCode&#xD;&#xA;                        Console.WriteLine(&quot;Room Type '&quot; &amp; strRoomType &amp; &quot;' found with code '&quot; &amp; roomTypeCode &amp; &quot;'&quot;)&#xD;&#xA;                        Exit For&#xD;&#xA;                    End If&#xD;&#xA;&#xD;&#xA;                Next&#xD;&#xA;&#xD;&#xA;                If Not String.IsNullOrWhiteSpace(roomTypeCode) Then Exit For&#xD;&#xA;&#xD;&#xA;            Next&#xD;&#xA;&#xD;&#xA;            Exit For&#xD;&#xA;&#xD;&#xA;        End If&#xD;&#xA;&#xD;&#xA;    Next&#xD;&#xA;&#xD;&#xA;    If String.IsNullOrWhiteSpace(roomTypeCode) Then&#xD;&#xA;        Throw New System.SystemException(&quot;Room Type '&quot; &amp; strRoomType &amp; &quot;' not found in available room types&quot;)&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ' OCCUPANCY&#xD;&#xA;    '=====================================================&#xD;&#xA;&#xD;&#xA;    Dim strOccupancy As String = &quot;1&quot;&#xD;&#xA;&#xD;&#xA;    If strRoomType.ToUpper().Contains(&quot;SINGLE&quot;) OrElse strRoomType.ToUpper().Contains(&quot;SUITE&quot;) Then&#xD;&#xA;        strOccupancy = &quot;1&quot;&#xD;&#xA;    ElseIf strRoomType.ToUpper().Contains(&quot;DOUBLE&quot;) OrElse strRoomType.ToUpper().Contains(&quot;TWIN&quot;) Then&#xD;&#xA;        strOccupancy = &quot;2&quot;&#xD;&#xA;    ElseIf strRoomType.ToUpper().Contains(&quot;TRIPLE&quot;) Then&#xD;&#xA;        strOccupancy = &quot;3&quot;&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ' BREAKFAST DEDUCTION&#xD;&#xA;    '=====================================================&#xD;&#xA;&#xD;&#xA;    If idictBlockDetails(&quot;strBreakfastDetails&quot;).ToString.ToUpper.Contains(&quot;BREAKFAST&quot;) Then&#xD;&#xA;&#xD;&#xA;        Dim breakfastCostPerPerson As Decimal = If(strHotelType.ToUpper() = &quot;LON&quot;, 7.8D, If(strHotelType.ToUpper() = &quot;IRE&quot;, 9.75D, If(strHotelType.ToUpper() = &quot;LGG&quot;, 13.0D, 7.2D)))&#xD;&#xA;        Dim occupancy As Integer = CInt(strOccupancy)&#xD;&#xA;&#xD;&#xA;        rateAmount = rateAmount - (breakfastCostPerPerson * occupancy)&#xD;&#xA;&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;    ' DINNER DEDUCTION - IRE ONLY&#xD;&#xA;    '=====================================================&#xD;&#xA;&#xD;&#xA;    If idictBlockDetails(&quot;strBreakfastDetails&quot;).ToString.ToUpper.Contains(&quot;DINNER&quot;) AndAlso strHotelType.ToUpper() = &quot;IRE&quot; Then&#xD;&#xA;&#xD;&#xA;        Dim breakfastCostPerPerson As Decimal = 23.75D&#xD;&#xA;        Dim occupancy As Integer = CInt(strOccupancy)&#xD;&#xA;&#xD;&#xA;        rateAmount = rateAmount - (breakfastCostPerPerson * occupancy)&#xD;&#xA;&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ' REPLACE ROOM GRID PLACEHOLDERS&#xD;&#xA;    '=====================================================&#xD;&#xA;&#xD;&#xA;    tempBody = tempBody.Replace(&quot;{{ArrivalDate}}&quot;, arrivalDate.ToString(&quot;yyyy-MM-dd&quot;))&#xD;&#xA;    tempBody = tempBody.Replace(&quot;{{DepartureDate}}&quot;, departureDate.ToString(&quot;yyyy-MM-dd&quot;))&#xD;&#xA;    tempBody = tempBody.Replace(&quot;{{RoomType}}&quot;, roomTypeCode)&#xD;&#xA;    tempBody = tempBody.Replace(&quot;{{RoomCount}}&quot;, row(&quot;strRoomsPerNight&quot;).ToString())&#xD;&#xA;    tempBody = tempBody.Replace(&quot;{{RateAmount&quot; &amp; strOccupancy &amp; &quot;}}&quot;, rateAmount.ToString(&quot;0.00&quot;))&#xD;&#xA;    tempBody = tempBody.Replace(&quot;{{RateAmount1}}&quot;, &quot;0.00&quot;)&#xD;&#xA;    tempBody = tempBody.Replace(&quot;{{RateAmount2}}&quot;, &quot;0.00&quot;)&#xD;&#xA;    tempBody = tempBody.Replace(&quot;{{RateAmount3}}&quot;, &quot;0.00&quot;)&#xD;&#xA;    tempBody = tempBody.Replace(&quot;{{RateAmount4}}&quot;, &quot;0.00&quot;)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ' ADD ROOM GRID ROW&#xD;&#xA;    '=====================================================&#xD;&#xA;&#xD;&#xA;    ostrMainBody = ostrMainBody.Replace(&quot;{{SingleRoomGrid}}&quot;, tempBody &amp; &quot;{{SingleRoomGrid}}&quot;)&#xD;&#xA;&#xD;&#xA;Next&#xD;&#xA;&#xD;&#xA;ostrMainBody = ostrMainBody.Replace(&quot;,{{SingleRoomGrid}}&quot;, &quot;&quot;)&#xD;&#xA;ostrMainBody = ostrMainBody.Replace(&quot;{{blockId}}&quot;, idictBlockDetails(&quot;strBlockId&quot;))&#xD;&#xA;ostrMainBody = ostrMainBody.Replace(&quot;{{HotelId}}&quot;, idictBlockDetails(&quot;strPropertyCode&quot;))&#xD;&#xA;&#xD;&#xA;" DisplayName="20.d Invoke Code for Room Grid Body" sap:VirtualizedContainerService.HintSize="416,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_8">
